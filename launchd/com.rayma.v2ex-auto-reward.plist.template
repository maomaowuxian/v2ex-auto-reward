<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.rayma.v2ex-auto-reward</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/Users/USERNAME/Documents/v2ex自动领奖励/src/claim.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/Documents/v2ex自动领奖励</string>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Documents/v2ex自动领奖励/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Documents/v2ex自动领奖励/logs/launchd.err.log</string>
  </dict>
</plist>
